# =============================================================================
# CSP2All API / worker configuration. Copy to apps/api/.env (dev) or your secret store (prod).
# NO REAL SECRETS IN THIS FILE. Generate secrets with:  openssl rand -hex 32
# Validated at startup (apps/api/src/config/config.ts); invalid config refuses to boot.
# =============================================================================

# development | test | staging | production  (staging/production enforce secure cookies, SMTP, BullMQ)
NODE_ENV=development
PORT=4610
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace (JSON logs, secrets redacted)

# Runtime role: NOT the table owner, NOBYPASSRLS -> PostgreSQL row-level security applies.
DATABASE_URL=postgresql://csp2all_app:CHANGE_ME@127.0.0.1:56632/csp2all_dev
# Owner role used ONLY for `prisma migrate deploy` (release step). Never used by the running app.
MIGRATION_DATABASE_URL=postgresql://csp2all_owner:CHANGE_ME@127.0.0.1:56632/csp2all_dev
REDIS_URL=redis://127.0.0.1:56679/0  # include password in production: redis://:PASSWORD@redis:6379/0

# Web origins allowed for CORS and CSRF Origin checks (tenant portal, admin console), comma-separated.
WEB_ORIGINS=http://localhost:3610,http://localhost:3611
PUBLIC_API_URL=http://localhost:4610
COOKIE_SECURE=false                 # MUST be true in staging/production (HTTPS)
COOKIE_DOMAIN=                      # optional, e.g. .csp2all.example
TRUST_PROXY=false                   # true when behind exactly one reverse proxy (Caddy/ALB)

# --- Secrets (separately managed; rotate per docs/OPERATIONS.md) ---
OTP_PEPPER=                         # >=32 chars; keyed hash for OTP codes
SECRETS_ENCRYPTION_KEY=             # 64 hex chars (32 bytes); AES-256-GCM for TOTP + connector credentials
FILE_URL_SIGNING_KEY=               # >=32 chars; signs short-lived local file URLs
IP_HASH_SALT=                       # >=16 chars; IPs are stored only as salted hashes

# --- OTP policy (defaults shown) ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_EMAIL_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=30
OTP_VERIFY_MAX_PER_IP_PER_10MIN=50

# --- Sessions ---
WEB_SESSION_IDLE_HOURS=168
WEB_SESSION_ABSOLUTE_DAYS=30
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=12
MOBILE_ACCESS_TOKEN_MINUTES=15
MOBILE_REFRESH_DAYS=30
API_RATE_LIMIT_PER_MINUTE=600       # per IP

# --- Email (adapter: smtp | memory (tests) | console (bodies suppressed)) ---
EMAIL_DRIVER=smtp
EMAIL_DELIVERY=queue                # queue (worker) | inline (dev/tests)
EMAIL_FROM="CSP2All <no-reply@csp2all.example>"
SMTP_HOST=127.0.0.1                 # Mailpit locally (UI http://127.0.0.1:56626)
SMTP_PORT=56625
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Private object storage (S3-compatible). Never make the bucket public. ---
STORAGE_DRIVER=s3                   # s3 | fs (tests only)
S3_ENDPOINT=http://127.0.0.1:56633  # omit for AWS S3
S3_REGION=ap-south-1
S3_BUCKET=csp2all-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_SCAN_DRIVER=none         # none (files marked SKIPPED) | clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SIGNED_URL_TTL_SECONDS=300

# --- Jobs ---
QUEUE_DRIVER=bullmq                 # bullmq | inline (tests)

# --- Connector (Pay2All live execution is NOT implemented; see docs/PAY2ALL_READINESS.md) ---
CONNECTOR_SIMULATOR_ENABLED=false   # dev/test only; refused in production
SIMULATOR_WEBHOOK_SECRET=
PROVIDER_TIMEOUT_MS=8000

# --- Observability ---
SENTRY_DSN=                         # error-monitoring integration point (no PII is sent)
METRICS_TOKEN=                      # if set, /metrics requires "Authorization: Bearer <token>"
API_DOCS_ENABLED=true               # set false to hide /docs and /openapi.json in production

# =============================================================================
# Web apps (apps/web, apps/admin): server-side only
# =============================================================================
API_URL=http://localhost:4610       # where the Next.js server proxies /api/* (internal URL in prod)
