{
  "name": "@csp2all/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "sh scripts/dev.sh",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "db:generate": "prisma generate",
    "db:migrate": "sh -c \"DATABASE_URL=${MIGRATION_DATABASE_URL:-$DATABASE_URL} prisma migrate deploy\"",
    "db:migrate:dev": "sh -c \"DATABASE_URL=${MIGRATION_DATABASE_URL:-$DATABASE_URL} prisma migrate dev\"",
    "db:seed": "node dist/cli/seed-reference.js",
    "db:seed:demo": "node dist/cli/seed-demo.js",
    "openapi": "node dist/cli/write-openapi.js",
    "bootstrap:admin": "node dist/cli/bootstrap-admin.js",
    "db:drift": "sh -c \"DATABASE_URL=${MIGRATION_DATABASE_URL:-$DATABASE_URL} prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url ${SHADOW_DATABASE_URL} --exit-code\"",
    "prebuild": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@csp2all/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "~6.19.3",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.13",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "^5.34.1",
    "zod": "^4.6.7",
    "prisma": "~6.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
